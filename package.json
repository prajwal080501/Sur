{
  "name": "sur",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint e2e playwright.config.ts --max-warnings 0 && turbo run lint",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @sur/api test:integration",
    "test:e2e": "playwright test",
    "test:loudness": "pnpm --filter @sur/audio-engine build && node scripts/verify-loudness.mjs",
    "test:workers": "PYTHONPATH=workers/ml python3 -m unittest discover -s workers/ml/tests -v",
    "verify:samples": "node --test scripts/sample-manifest.test.mjs && node scripts/verify-sample-manifest.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && turbo run typecheck",
    "verify": "pnpm verify:samples && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
