{
  "name": "@sur/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src --max-warnings 0",
    "start": "node dist/main.js",
    "test": "vitest run --exclude 'src/integration/**'",
    "test:integration": "vitest run src/integration/*.integration.test.ts --testTimeout=120000 --hookTimeout=120000",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@sur/job-domain": "workspace:*",
    "@sur/share-domain": "workspace:*",
    "@sur/shared-types": "workspace:*",
    "jose": "^6.2.12",
    "mongodb": "^7.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@testcontainers/localstack": "12.2.0",
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.0",
    "mongodb-memory-server-core": "11.3.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0"
  }
}
