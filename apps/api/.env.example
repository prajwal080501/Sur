NODE_ENV=development
PORT=3000
SUR_ADAPTER_MODE=memory
SUR_AUTH_MODE=development
WORKER_CALLBACK_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_WEB_BASE_URL=http://localhost:5173
PUBLIC_MEDIA_BASE_URL=http://localhost:3000/public-media/

# Required when SUR_AUTH_MODE=jwt. Keep the asymmetric algorithm allowlist narrow.
# AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# AUTH_JWT_ISSUER=https://identity.example.com
# AUTH_JWT_AUDIENCE=sur-api
# AUTH_JWT_ALGORITHMS=RS256

# Required when SUR_ADAPTER_MODE=cloud
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DATABASE=sur
AWS_REGION=ap-south-1
S3_BUCKET_MEDIA=sur-media-development
SQS_JOBS_URL=https://sqs.ap-south-1.amazonaws.com/000000000000/sur-jobs
# Use the HTTPS CloudFront origin serving the public-shares/ prefix.
# PUBLIC_MEDIA_BASE_URL=https://media.example.com/
